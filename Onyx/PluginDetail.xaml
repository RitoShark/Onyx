<UserControl x:Class="Onyx.PluginDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
                <Rectangle Fill="{DynamicResource Scrim}" />
                <Border DataContext="{Binding Detail}"
                        Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource SeparatorStrong}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22"
                        Width="520"
                        MaxHeight="640"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.16" />
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    From="0,18,0,0" To="0,0,0,0" Duration="0:0:0.18">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="10"
                                        Background="{DynamicResource SurfaceSunken}"
                                        BorderBrush="{DynamicResource Separator}"
                                        BorderThickness="1" />
                                <Image Source="{Binding IconImage}"
                                       Width="26" Height="26"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVisibility}}" />
                                <Path Data="{Binding IconGeometry}"
                                      Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding HasIconImage, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingText}" FontSize="17" />
                                <TextBlock Text="{Binding Summary}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Version"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource OnyxComboBox}"
                                      ItemsSource="{Binding Versions}"
                                      SelectedItem="{Binding SelectedVersion}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"
                                                   FontFamily="{StaticResource TextFont}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Targets}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceSunken}"
                                            BorderBrush="{DynamicResource Separator}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,7"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Path}"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="10,0"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Surface}"
                                                        BorderBrush="{DynamicResource Separator}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="8,2"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                                <Button Style="{StaticResource ChromeButton}"
                                                        Width="24" Height="22"
                                                        Command="{Binding OpenCommand}"
                                                        ToolTip="Open folder">
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="M 1,3 H 5 L 6.5,4.5 H 12 V 10.5 H 1 Z"
                                                              Stroke="{DynamicResource TextSecondary}"
                                                              StrokeThickness="1.2"
                                                              StrokeLineJoin="Round"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="3"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Separator}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,11"
                                MinHeight="70">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding About}"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           LineHeight="19"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource DangerLinkButton}"
                                        Content="Uninstall"
                                        Command="{Binding UninstallCommand}" />
                                <Button Style="{StaticResource LinkButton}"
                                        Content="GitHub"
                                        Command="{Binding OpenRepoCommand}" />
                                <Button Style="{StaticResource LinkButton}"
                                        Content="Choose folder…"
                                        Command="{Binding ChooseFolderCommand}"
                                        Visibility="{Binding ShowsChooseFolder, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Close"
                                        Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,10,0" />
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="{Binding PrimaryActionLabel}"
                                        Command="{Binding InstallCommand}"
                                        IsEnabled="{Binding CanAct}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
</UserControl>
