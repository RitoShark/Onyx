<Window x:Class="Onyx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Onyx"
        Style="{StaticResource OnyxWindow}"
        Title="Onyx"
        Width="720" Height="760"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="40">
            <TextBlock Text="Onyx"
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeButton}" Click="Minimise" ToolTip="Minimise">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 0,0 H 10"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource ChromeButton}" Click="CloseWindow" ToolTip="Close">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="28,8,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Plugins" Style="{StaticResource TitleText}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding LastChecked}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="  ·  " Style="{StaticResource CaptionText}">
                        <TextBlock.Visibility>
                            <Binding Path="StatusMessage" Converter="{StaticResource NotEmptyToVisibility}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource PillButton}"
                    Content="Check for Updates"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="28,0,20,24"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:PluginRow Margin="0,0,0,10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Visibility="{Binding Sheet.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <Rectangle Fill="{DynamicResource Scrim}" />
                <Border Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource Separator}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        Width="420"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.28" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding Sheet.Title}" Style="{StaticResource HeadingText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Sheet.Message}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Cancel"
                                    Command="{Binding Sheet.CancelCommand}"
                                    Margin="0,0,10,0" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding Sheet.PrimaryLabel}"
                                    Command="{Binding Sheet.PrimaryCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
