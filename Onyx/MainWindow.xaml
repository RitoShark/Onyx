<Window x:Class="Onyx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Onyx"
        Style="{StaticResource OnyxWindow}"
        Title="Onyx"
        Width="740" Height="820"
        MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Path Data="M 8,1.5 L 14,5 V 11 L 8,14.5 L 2,11 V 5 Z"
                      Stroke="{DynamicResource Accent}"
                      StrokeThickness="1.5"
                      StrokeLineJoin="Round"
                      Width="15" Height="15"
                      Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock Text="Onyx"
                           Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeButton}" Click="Minimise" ToolTip="Minimise">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 0,0 H 10"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource ChromeButton}" Click="CloseWindow" ToolTip="Close">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,6,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Plugins" Style="{StaticResource TitleText}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding LastChecked}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="  ·  " Style="{StaticResource CaptionText}">
                        <TextBlock.Visibility>
                            <Binding Path="StatusMessage" Converter="{StaticResource NotEmptyToVisibility}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource PillButton}"
                    Content="Check for Updates"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="24,0,16,20"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                    <Path Data="{Binding Icon}"
                                          Stroke="{DynamicResource Accent}"
                                          StrokeThickness="1.3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <local:PluginRow Margin="0,0,0,8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
                <Rectangle Fill="{DynamicResource Scrim}" />
                <Border DataContext="{Binding Detail}"
                        Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource SeparatorStrong}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Width="520"
                        MaxHeight="640"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.16" />
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                                    From="0,18,0,0" To="0,0,0,0" Duration="0:0:0.18">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="9"
                                        Background="{DynamicResource SurfaceSunken}"
                                        BorderBrush="{DynamicResource Separator}"
                                        BorderThickness="1" />
                                <Image Source="{Binding IconImage}"
                                       Width="26" Height="26"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVisibility}}" />
                                <Path Data="{Binding IconGeometry}"
                                      Stroke="{DynamicResource Accent}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding HasIconImage, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingText}" FontSize="17" />
                                <TextBlock Text="{Binding Summary}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Version"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <ComboBox Grid.Column="1"
                                      Style="{StaticResource OnyxComboBox}"
                                      ItemsSource="{Binding Versions}"
                                      SelectedItem="{Binding SelectedVersion}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"
                                                   FontFamily="{StaticResource TextFont}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Targets}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceSunken}"
                                            BorderBrush="{DynamicResource Separator}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="10,7"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Path}"
                                                       Style="{StaticResource CaptionText}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="10,0"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Surface}"
                                                        BorderBrush="{DynamicResource Separator}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="8,2"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                                <Button Style="{StaticResource ChromeButton}"
                                                        Width="24" Height="22"
                                                        Command="{Binding OpenCommand}"
                                                        ToolTip="Open folder">
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="M 1,3 H 5 L 6.5,4.5 H 12 V 10.5 H 1 Z"
                                                              Stroke="{DynamicResource TextSecondary}"
                                                              StrokeThickness="1.2"
                                                              StrokeLineJoin="Round"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="3"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Separator}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,10"
                                MinHeight="70">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ReleaseNotes}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource DangerLinkButton}"
                                        Content="Uninstall"
                                        Command="{Binding UninstallCommand}" />
                                <Button Style="{StaticResource LinkButton}"
                                        Content="Choose folder…"
                                        Command="{Binding ChooseFolderCommand}"
                                        Visibility="{Binding ShowsChooseFolder, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Close"
                                        Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,10,0" />
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="{Binding PrimaryActionLabel}"
                                        Command="{Binding InstallCommand}"
                                        IsEnabled="{Binding CanAct}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3" Visibility="{Binding Sheet.IsOpen, Converter={StaticResource BoolToVisibility}}">
                <Rectangle Fill="{DynamicResource Scrim}" />
                <Border Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource SeparatorStrong}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        Width="420"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.4" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding Sheet.Title}" Style="{StaticResource HeadingText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Sheet.Message}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Cancel"
                                    Command="{Binding Sheet.CancelCommand}"
                                    Margin="0,0,10,0" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding Sheet.PrimaryLabel}"
                                    Command="{Binding Sheet.PrimaryCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
    </Grid>
</Window>
