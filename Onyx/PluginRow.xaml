<UserControl x:Class="Onyx.PluginRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
        <StackPanel>
            <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7"
                            Background="{DynamicResource SurfaceSunken}"
                            BorderBrush="{DynamicResource Separator}"
                            BorderThickness="1" />
                    <Path Data="{Binding IconGeometry}"
                          Stroke="{DynamicResource Accent}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingText}" />
                        <Border Background="{DynamicResource AccentGradient}"
                                CornerRadius="7"
                                Height="16"
                                Padding="7,0"
                                Margin="8,1,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowsUpdateBadge, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Update"
                                       Foreground="{DynamicResource AccentText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Summary}"
                               Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0" />

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding HostLabel, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding HostPath, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionChip}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="{Binding PrimaryActionLabel}"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding CanAct}" />

                    <Button Style="{StaticResource ChromeButton}"
                            Command="{Binding ToggleCommand}"
                            Margin="4,0,0,0"
                            ToolTip="Details">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 0,0 L 4,4 L 8,0"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="Expansion"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceSunken}"
                    CornerRadius="0,0,9,9"
                    ClipToBounds="True"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MaxHeight" Value="0" />
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                             To="420" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Version"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource OnyxComboBox}"
                                  ItemsSource="{Binding Versions}"
                                  SelectedItem="{Binding SelectedVersion}"
                                  HorizontalAlignment="Left"
                                  MinWidth="300">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"
                                               FontFamily="{StaticResource TextFont}"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Targets}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource Separator}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="10,7"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Path}"
                                                   Style="{StaticResource CaptionText}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource SurfaceSunken}"
                                                    BorderBrush="{DynamicResource Separator}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,2"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                            <Button Style="{StaticResource ChromeButton}"
                                                    Width="24" Height="22"
                                                    Command="{Binding OpenCommand}"
                                                    ToolTip="Open folder">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="M 1,3 H 5 L 6.5,4.5 H 12 V 10.5 H 1 Z"
                                                          Stroke="{DynamicResource TextSecondary}"
                                                          StrokeThickness="1.2"
                                                          StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Separator}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,10"
                            Margin="0,4,0,0"
                            MaxHeight="130">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReleaseNotes}"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource LinkButton}"
                                Content="Choose folder…"
                                Command="{Binding ChooseFolderCommand}"
                                Visibility="{Binding ShowsChooseFolder, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource DangerLinkButton}"
                                Content="Uninstall"
                                Command="{Binding UninstallCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
