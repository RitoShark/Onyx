<UserControl x:Class="Onyx.PluginRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
        <StackPanel>
            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource Control}" />
                    <Path Data="{Binding IconGeometry}"
                          Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingText}" />
                        <Border Background="{DynamicResource Accent}"
                                CornerRadius="7"
                                Height="16"
                                Padding="7,0"
                                Margin="8,1,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowsUpdateBadge, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Update"
                                       Foreground="{DynamicResource AccentText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Summary}"
                               Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0" />

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding HostLabel, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding HostPath, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionChip}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="{Binding PrimaryActionLabel}"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding CanAct}" />

                    <Button Style="{StaticResource ChromeButton}"
                            Command="{Binding ToggleCommand}"
                            Margin="4,0,0,0"
                            ToolTip="Details">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 0,0 L 4,4 L 8,0"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="Expansion"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceSunken}"
                    CornerRadius="0,0,9,9"
                    ClipToBounds="True"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Version"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource OnyxComboBox}"
                                  ItemsSource="{Binding Versions}"
                                  SelectedItem="{Binding SelectedVersion}"
                                  HorizontalAlignment="Left"
                                  MinWidth="300">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"
                                               FontFamily="{StaticResource TextFont}"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Separator}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,10"
                            Margin="0,12,0,0"
                            MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReleaseNotes}"
                                       Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource LinkButton}"
                                Content="Reveal in Explorer"
                                Command="{Binding RevealCommand}" />
                        <Button Style="{StaticResource DangerLinkButton}"
                                Content="Uninstall"
                                Command="{Binding UninstallCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
