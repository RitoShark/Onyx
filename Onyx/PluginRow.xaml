<UserControl x:Class="Onyx.PluginRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
        <Grid Margin="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="8"
                        Background="{DynamicResource SurfaceSunken}"
                        BorderBrush="{DynamicResource Separator}"
                        BorderThickness="1" />
                <Image Source="{Binding IconImage}"
                       Width="20" Height="20"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVisibility}}" />
                <Path Data="{Binding IconGeometry}"
                      Stroke="{DynamicResource Accent}"
                      StrokeThickness="1.7"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasIconImage, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource HeadingText}" />
                    <Border Background="{DynamicResource AccentGradient}"
                            CornerRadius="7"
                            Height="16"
                            Padding="7,0"
                            Margin="8,1,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowsUpdateBadge, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Update"
                                   Foreground="{DynamicResource AccentText}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding Summary}"
                           Style="{StaticResource BodyText}"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,3,0,0" />

                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding HostLabel, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding HostPath, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" />
                </TextBlock>

                <TextBlock Text="{Binding BlockedNote}"
                           Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0"
                           Visibility="{Binding BlockedNote, Converter={StaticResource NotEmptyToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding VersionChip}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <Button Style="{StaticResource PrimaryButton}"
                        Content="{Binding PrimaryActionLabel}"
                        Command="{Binding InstallCommand}"
                        IsEnabled="{Binding CanAct}" />

                <Button Style="{StaticResource ChromeButton}"
                        Command="{Binding DetailsCommand}"
                        Margin="4,0,0,0"
                        ToolTip="Details">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 0,0 L 4,4 L 0,8"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
