<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="SurfaceColor">#FF0D0D0F</Color>
    <Color x:Key="SurfaceRaisedColor">#FF141417</Color>
    <Color x:Key="SurfaceSunkenColor">#FF1B1B1F</Color>
    <Color x:Key="SeparatorColor">#FF2A2A30</Color>
    <Color x:Key="SeparatorStrongColor">#FF3A3A42</Color>
    <Color x:Key="TextPrimaryColor">#FFEDEDF0</Color>
    <Color x:Key="TextSecondaryColor">#FFB4B4BB</Color>
    <Color x:Key="TextMutedColor">#FF75757E</Color>
    <Color x:Key="AccentColor">#FF3FA6F4</Color>
    <Color x:Key="AccentSecondaryColor">#FF0F90F1</Color>
    <Color x:Key="AccentHoverColor">#FF66B8F6</Color>
    <Color x:Key="AccentMutedColor">#FF1E5681</Color>
    <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
    <Color x:Key="ControlColor">#FF232328</Color>
    <Color x:Key="ControlPressedColor">#FF2E2E34</Color>
    <Color x:Key="SuccessColor">#FF34D399</Color>
    <Color x:Key="DangerColor">#FFEF6A5A</Color>
    <Color x:Key="ScrimColor">#8C000000</Color>

    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="{StaticResource SurfaceSunkenColor}" />
    <SolidColorBrush x:Key="Separator" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="SeparatorStrong" Color="{StaticResource SeparatorStrongColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentMuted" Color="{StaticResource AccentMutedColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="Control" Color="{StaticResource ControlColor}" />
    <SolidColorBrush x:Key="ControlPressed" Color="{StaticResource ControlPressedColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Scrim" Color="{StaticResource ScrimColor}" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentSecondaryColor}" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
